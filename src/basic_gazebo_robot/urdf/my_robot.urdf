<?xml version="1.0"?>

<robot name="my_robot">

  <!-- ===================================================== -->
  <!-- BASE                                                   -->
  <!-- ===================================================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.3"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.3"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.1167"
        ixy="0.0"
        ixz="0.0"
        iyy="0.175"
        iyz="0.0"
        izz="0.2417"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- LEFT DRIVE WHEEL                                      -->
  <!-- ===================================================== -->

  <link name="left_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.0025"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0025"
        iyz="0.0"
        izz="0.0025"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- RIGHT DRIVE WHEEL                                     -->
  <!-- ===================================================== -->

  <link name="right_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.0025"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0025"
        iyz="0.0"
        izz="0.0025"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- DRIVE WHEEL JOINTS                                    -->
  <!-- Wheels moved backward: X = -0.10                     -->
  <!-- ===================================================== -->

  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin xyz="-0.15 0.225 0.10" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin xyz="-0.15 -0.225 0.10" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- FRONT CASTER WHEEL                                    -->
  <!-- ===================================================== -->

  <link name="caster_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="caster_black">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.0002"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0002"
        iyz="0.0"
        izz="0.0002"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- FRONT CASTER JOINT                                    -->
  <!-- Caster is under the front of body and touches ground -->
  <!-- ===================================================== -->

  <joint name="caster_joint" type="fixed">

    <parent link="base_link"/>
    <child link="caster_link"/>

    <origin xyz="0.25 0 0.06" rpy="0 0 0"/>

  </joint>

  <gazebo reference="caster_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>100000</kp>
    <kd>1000</kd>
  </gazebo>


  <!-- ===================================================== -->
  <!-- LIDAR                                                  -->
  <!-- ===================================================== -->

  <link name="lidar_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.08"/>
      </geometry>
      <material name="lidar_red">
        <color rgba="1.0 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- LIDAR FIXED JOINT                                    -->
  <!-- ===================================================== -->

  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.45" rpy="0 0 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- GAZEBO LIDAR SENSOR                                  -->
  <!-- ===================================================== -->

  <gazebo reference="lidar_link">

    <sensor name="lidar_sensor" type="ray">

      <pose>0 0 0 0 0 0</pose>

      <visualize>true</visualize>

      <update_rate>10</update_rate>

      <ray>

        <scan>

          <horizontal>

            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>

          </horizontal>

        </scan>

        <range>

          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>

        </range>

      </ray>

      <plugin
        name="lidar_plugin"
        filename="libgazebo_ros_ray_sensor.so">

        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>

        <output_type>sensor_msgs/LaserScan</output_type>

        <frame_name>lidar_link</frame_name>

      </plugin>

    </sensor>

  </gazebo>


  <!-- ===================================================== -->
  <!-- GAZEBO DIFFERENTIAL DRIVE                            -->
  <!-- ===================================================== -->

  <gazebo>

    <plugin
      name="diff_drive"
      filename="libgazebo_ros_diff_drive.so">

      <ros>
        <namespace>/</namespace>
      </ros>

      <update_rate>50</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.45</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>

      <odometry_topic>odom</odometry_topic>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

    </plugin>


    <!-- ================================================= -->
    <!-- JOINT STATE PUBLISHER                             -->
    <!-- ================================================= -->

    <plugin
      name="joint_state_publisher"
      filename="libgazebo_ros_joint_state_publisher.so">

      <update_rate>50</update_rate>

      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>

    </plugin>

  </gazebo>

</robot>