<?xml version="1.0"?>

<robot name="basic_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== -->
  <!-- Materials -->
  <!-- ===================== -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>


  <!-- ===================== -->
  <!-- Base -->
  <!-- ===================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.8 0.5 0.3"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.8 0.5 0.3"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.13"
        ixy="0"
        ixz="0"
        iyy="0.33"
        iyz="0"
        izz="0.42"/>
    </inertial>

  </link>


  <!-- ===================== -->
  <!-- Left wheel -->
  <!-- ===================== -->

  <link name="left_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.005"
        ixy="0"
        ixz="0"
        iyy="0.005"
        iyz="0"
        izz="0.005"/>
    </inertial>

  </link>

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.3 0.15"/>
    <axis xyz="0 1 0"/>

  </joint>


  <!-- ===================== -->
  <!-- Right wheel -->
  <!-- ===================== -->

  <link name="right_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.005"
        ixy="0"
        ixz="0"
        iyy="0.005"
        iyz="0"
        izz="0.005"/>
    </inertial>

  </link>

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.3 0.15"/>
    <axis xyz="0 1 0"/>

  </joint>


  <!-- ===================== -->
  <!-- Caster -->
  <!-- ===================== -->

  <link name="caster">

    <visual>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="caster_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="caster"/>

    <origin xyz="-0.3 0 0.05"/>

  </joint>


  <!-- ===================== -->
  <!-- Gazebo -->
  <!-- ===================== -->

  <gazebo reference="base_link">

    <material>Gazebo/Blue</material>

  </gazebo>


  <gazebo reference="left_wheel">

    <material>Gazebo/Black</material>

  </gazebo>


  <gazebo reference="right_wheel">

    <material>Gazebo/Black</material>

  </gazebo>


  <gazebo reference="caster">

    <material>Gazebo/Black</material>

  </gazebo>


  <!-- Differential drive -->

  <gazebo>

    <plugin
      name="diff_drive"
      filename="libgazebo_ros_diff_drive.so">

      <ros>
        <namespace>/</namespace>
      </ros>

      <update_rate>50</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.6</wheel_separation>
      <wheel_diameter>0.3</wheel_diameter>

      <command_topic>cmd_vel</command_topic>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>

    </plugin>

  </gazebo>

</robot>
